<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <Title Value="LazAssPicker"/>
      <SessionStorage Value="InProjectDir"/>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes><Item Name="Default" Default="True"/></BuildModes>
    <RequiredPackages>
